# Smart Health Assistant environment template
# Copy to .env for local development and fill values as needed. NEVER commit real secrets.

# =========================
# App / API
# =========================
APP_NAME=Smart Health Assistant
APP_ENV=development            # use "production" on Render
DEBUG=false                   # keep false in production
API_V1_PREFIX=/api/v1
PORT=8000                     # Render injects PORT automatically for the web service

# CORS: comma-separated list of allowed frontend origins (no trailing slash)
# Local dev example:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Production example (replace with your actual Render Static Site URL):
# CORS_ORIGINS=https://smart-health-assistant-frontend.onrender.com

# =========================
# Database
# =========================
# Local fallback (SQLite):
DATABASE_URL=sqlite:///./smarthealth.db
# Supabase PostgreSQL (production/public deployment) - use the value from Supabase project settings
# Recommended format for this app (SQLAlchemy + psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# The app also normalizes postgres:// and postgresql:// URLs automatically.

# =========================
# ML / Dataset
# =========================
TRAIN_DATA_PATH=data/raw/Training.csv
TEST_DATA_PATH=data/raw/Testing.csv
MODEL_ARTIFACT_DIR=ml/artifacts
MODEL_METADATA_PATH=ml/artifacts/metadata.json

# =========================
# RAG / ChromaDB
# =========================
CHROMA_PERSIST_DIR=rag/chroma_db
CHROMA_COLLECTION=medical_knowledge
MEDICAL_DOCS_DIR=data/medical_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4

# =========================
# Gemini (backend only - never expose in frontend)
# =========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_ENABLED=true

# =========================
# Frontend (Vite) - use frontend/.env for local frontend dev, or Render static site env var
# =========================
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_API_BASE_URL=https://<your-backend-service>.onrender.com/api/v1
